[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse, open and organise files
Exec=neo-files %f
Icon=org.neo.Files
Terminal=false
Categories=System;FileTools;FileManager;Utility;Core;
Keywords=folder;manager;explore;disk;filesystem;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=org.neo.Files
